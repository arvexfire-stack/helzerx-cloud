# Copy to .env for local development. Never commit .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173

# PostgreSQL: create a dedicated least-privilege database user.
# DATABASE_URL=postgresql://helzerx_app:CHANGE_ME@127.0.0.1:5432/helzerx_cloud
DB_POOL_MAX=10
DATABASE_SSL=false

# Email registration stays disabled until SMTP is configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=HelzerX Cloud <no-reply@example.com>

# Proxmox adapter configuration. Keep these in a secret manager in production.
# The API token must be dedicated, privilege-separated, and limited to the needed LXC actions.
# PROXMOX_API_URL=https://pve.internal.example:8006
# PROXMOX_API_TOKEN_ID=helzerx@pve!cloud-worker
# PROXMOX_API_TOKEN_SECRET=
# PROXMOX_ALLOWED_NODES=pve-node-1
# Exact allowed template storage volume paths, e.g. local:vztmpl/debian-12-standard_12.7-1_amd64.tar.zst
# PROXMOX_ALLOWED_TEMPLATES=local:vztmpl/debian-12-standard_12.7-1_amd64.tar.zst
# PROXMOX_ALLOWED_STORAGE=local-lvm
# PROXMOX_ALLOWED_BRIDGES=vmbr0

# Payment provider credentials are added only after merchant accounts are approved.
# PAYHERE_MERCHANT_ID=
# PAYHERE_MERCHANT_SECRET=
# ONEPAY_API_KEY=
