# Copy to .env for local development. Never commit .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
# Exact frontend origin, no trailing slash.
FRONTEND_ORIGIN=http://localhost:5173

# Local PostgreSQL database; create a dedicated least-privilege DB/user.
# DATABASE_URL=postgresql://helzerx_app:CHANGE_ME@127.0.0.1:5432/helzerx_cloud
DB_POOL_MAX=10
DATABASE_SSL=false

# Registration stays disabled until all SMTP values are configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=HelzerX Cloud <no-reply@example.com>

# Set only in local development if you need to inspect the verification link.
DEV_SHOW_VERIFICATION_TOKEN=false

# Future phases: configure in deployment secret manager, not in Git.
# PAYHERE_MERCHANT_ID=
# PAYHERE_MERCHANT_SECRET=
# ONEPAY_API_KEY=
# PROXMOX_API_URL=
# PROXMOX_API_TOKEN_ID=
# PROXMOX_API_TOKEN_SECRET=
