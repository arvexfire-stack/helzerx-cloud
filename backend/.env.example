# Copy to .env for local development. Never commit .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
# Exact frontend origin, no trailing slash.
FRONTEND_ORIGIN=http://localhost:5173

# Local PostgreSQL database; create a dedicated least-privilege DB/user.
# DATABASE_URL=postgresql://helzerx_app:CHANGE_ME@127.0.0.1:5432/helzerx_cloud
DB_POOL_MAX=10
DATABASE_SSL=false

# Future phases: configure in deployment secret manager, not in Git.
# SESSION_SECRET=
# PAYHERE_MERCHANT_ID=
# PAYHERE_MERCHANT_SECRET=
# ONEPAY_API_KEY=
# PROXMOX_API_URL=
# PROXMOX_API_TOKEN_ID=
# PROXMOX_API_TOKEN_SECRET=
